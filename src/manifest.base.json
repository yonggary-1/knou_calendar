{
  "manifest_version": 3,
  "name": "Knou calendar",
  "version": "1.3.0",
  "description": "방통대(MyKNOU) 출석수업·중간/기말평가 일정을 구글 캘린더 전용 캘린더에 자동으로 넣어줍니다.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Knou calendar",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "identity", "scripting"],
  "host_permissions": ["https://*.knou.ac.kr/*"]
}
